# ============================================================
# RFP-Assistant — Environment Configuration
# Copy this file to .env and fill in real values before deploy
# NEVER commit .env to version control
# ============================================================

# ── PostgreSQL ──
POSTGRES_DB=rfp_assistant
POSTGRES_USER=rfp_user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_32chars

# ── Application ──
SECRET_KEY=CHANGE_ME_use_python_c_import_secrets_secrets_token_urlsafe_64
ADMIN_EMAIL=admin@rfp-assistant.fr
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_16chars

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_32chars

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# ── Ollama (LLM) ──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_NER_MODEL=qwen2.5:14b

# ── HuggingFace (optional) ──
HF_TOKEN=

# ── Debug (set to false in production) ──
DEBUG=false
